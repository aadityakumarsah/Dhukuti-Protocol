{
  "name": "dhukuti-protocol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:program": "cargo build-sbf --manifest-path programs/dhukuti/Cargo.toml --sbf-out-dir target/deploy",
    "validator": "solana-test-validator --reset --bpf-program egyrA1EJRsr2b7QbciVXX78U3TkPy8GQ9dTDJQHPHvo target/deploy/dhukuti.so",
    "test:local": "ANCHOR_PROVIDER_URL=http://127.0.0.1:8899 ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-mocha -p ./tsconfig.json -t 1000000 tests/dhukuti.ts",
    "test": "anchor test",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "lint": "npm --prefix app run lint"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.98.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
